# 起了吗App - 开发环境变量
# 注意：敏感信息不要提交到版本控制系统

# 环境类型
ENVIRONMENT=development

# 调试模式
DEBUG=true

# 数据库配置（开发环境使用SQLite）
DATABASE_URL=sqlite:///./qilema_dev.db

# JWT密钥（仅用于开发，生产环境必须更改）
SECRET_KEY=test_secret_key_at_least_64_bytes_long_for_testing_purposes_only_do_not_use_in_production

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 短信服务配置（开发环境使用Mock）
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
