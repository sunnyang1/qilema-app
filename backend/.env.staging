# 起了吗App - 测试环境变量
# 注意：敏感信息不要提交到版本控制系统

# 环境类型
ENVIRONMENT=testing

# 调试模式
DEBUG=false

# 数据库配置（测试环境使用PostgreSQL）
DATABASE_URL=postgresql://qilema:qilema_test_password@localhost:5432/qilema_staging

# JWT密钥
SECRET_KEY=请使用以下命令生成：python scripts/generate_secret_key.py

# Redis配置
REDIS_URL=redis://localhost:6379/1

# 短信服务配置
SMS_ACCESS_KEY=your_aliyun_access_key
SMS_SECRET_KEY=your_aliyun_secret_key
