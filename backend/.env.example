# 起了吗App - 后端环境配置示例

# ========== 安全配置 ==========
# 使用以下命令生成强随机密钥：python scripts/generate_secret_key.py
SECRET_KEY=your-secret-key-here

# ========== 数据库配置 ==========
DATABASE_URL=postgresql://postgres:password@localhost:5432/qilema_db

# ========== Redis配置 ==========
REDIS_URL=redis://localhost:6379/0

# ========== 应用配置 ==========
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ========== 环境配置 ==========
ENVIRONMENT=development

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_TO_CONSOLE=True
LOG_TO_FILE=True
LOG_DIR=logs

# ========== 第三方服务配置 ==========
# 短信服务配置（真实环境使用）
# SMS_ACCESS_KEY_ID=your-access-key
# SMS_ACCESS_KEY_SECRET=your-secret
# SMS_SIGN_NAME=起了吗
# SMS_TEMPLATE_CODE=SMS_123456789

# ========== 邮件服务配置 ==========
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-password
# EMAIL_FROM=noreply@qilema.com

# ========== 文件存储配置 ==========
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE=10485760  # 10MB

# ========== 缓存配置 ==========
# CACHE_TTL=3600  # 1小时
# CACHE_KEY_PREFIX=qilema_app