# 环境变量配置示例文件
# 复制此文件为 .env 并填入实际值

# ========== 环境配置 ==========
ENVIRONMENT=development

# 调试模式（生产环境必须为False）
DEBUG=True

# ========== JWT密钥配置（必须）==========
# 开发环境可以使用默认值，但生产环境必须使用强随机密钥
# 使用以下命令生成强随机密钥（在项目根目录执行）:
#   python backend/scripts/generate_secret_key.py
SECRET_KEY=dev-only-change-in-production

# ========== 数据库配置 ==========
DATABASE_URL=sqlite:///./qilema.db

# ========== 数据加密配置（可选）==========
# 使用以下命令生成加密密钥:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ========== Redis配置（可选）==========
REDIS_URL=redis://localhost:6379/0

# ========== 短信服务配置（可选）==========
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# ========== 签到配置 ==========
DEFAULT_CHECKIN_HOURS=24
