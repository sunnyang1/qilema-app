# 起了吗App - 生产环境变量
# ⚠️  警告：此文件包含敏感信息，请勿提交到版本控制系统

# 环境类型
ENVIRONMENT=production

# 调试模式
DEBUG=false

# 数据库配置（生产环境必须设置）
DATABASE_URL=postgresql://user:password@prod-db-host:5432/qilema_prod

# JWT密钥（生产环境必须使用强随机密钥）
SECRET_KEY=请使用以下命令生成：python scripts/generate_secret_key.py

# Redis配置（生产环境必须设置）
REDIS_URL=redis://:password@prod-redis-host:6379/0

# 短信服务配置（生产环境必须设置）
SMS_ACCESS_KEY=your_prod_aliyun_access_key
SMS_SECRET_KEY=your_prod_aliyun_secret_key
