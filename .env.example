# 起了吗App 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改配置值

# ========== 环境配置 ==========
# 环境: development | testing | production
ENVIRONMENT=development

# ========== 应用配置 ==========
# 应用名称
APP_NAME=起了吗App
# 应用版本
APP_VERSION=1.0.0
# 应用描述
APP_DESCRIPTION=为独居人群提供紧急医疗救助服务
# 调试模式 (production环境必须为False)
DEBUG=True

# ========== API配置 ==========
# API版本前缀
API_V1_PREFIX=/api/v1

# ========== CORS配置 ==========
# 允许的跨域来源 (生产环境请设置具体域名)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ========== 数据库配置 ==========
# 数据库连接字符串
# SQLite (开发环境): sqlite:///./qilema.db
# PostgreSQL (生产环境): postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./qilema.db

# ========== JWT配置 ==========
# JWT密钥 (生产环境必须修改为强随机密钥，至少64字节)
SECRET_KEY=your-secret-key-change-in-production
# JWT算法
ALGORITHM=HS256
# Access Token过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== Redis配置 ==========
# Redis连接字符串
REDIS_URL=redis://localhost:6379/0

# ========== 短信服务配置 ==========
# 短信服务访问密钥 (可选)
SMS_ACCESS_KEY=
# 短信服务密钥 (可选)
SMS_SECRET_KEY=

# ========== 签到配置 ==========
# 默认签到预警小时数
DEFAULT_CHECKIN_HOURS=24

# ========== 紧急求助配置 ==========
# SOS联系人通知渠道
SOS_CONTACT_NOTIFY_CHANNELS=push,sms
